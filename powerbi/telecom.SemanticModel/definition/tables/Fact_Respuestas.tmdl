table Fact_Respuestas
	lineageTag: db5e6ffa-2427-4901-a973-3673b3c1d6cf

	measure 'Total Encuestados' = COUNTROWS(Fact_Respuestas)
		formatString: #,##0
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000001

	measure 'CSAT Promedio' = AVERAGE(Fact_Respuestas[csat_promedio])
		formatString: 0.00
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000002

	measure '% Promotores' = DIVIDE(CALCULATE(COUNTROWS(Fact_Respuestas), Fact_Respuestas[nps_category] = "Promotor"), [Total Encuestados], 0)
		formatString: 0.0%
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000003

	measure '% Detractores' = DIVIDE(CALCULATE(COUNTROWS(Fact_Respuestas), Fact_Respuestas[nps_category] = "Detractor"), [Total Encuestados], 0)
		formatString: 0.0%
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000004

	measure '% Pasivos' = DIVIDE(CALCULATE(COUNTROWS(Fact_Respuestas), Fact_Respuestas[nps_category] = "Pasivo"), [Total Encuestados], 0)
		formatString: 0.0%
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000005

	measure 'NPS Score' = ([% Promotores] - [% Detractores]) * 100
		formatString: #,##0.0
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000006

	measure '% Churn Alto' = DIVIDE(CALCULATE(COUNTROWS(Fact_Respuestas), Fact_Respuestas[riesgo_churn] = "Alto"), [Total Encuestados], 0)
		formatString: 0.0%
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000007

	measure '% Churn Bajo' = DIVIDE(CALCULATE(COUNTROWS(Fact_Respuestas), Fact_Respuestas[riesgo_churn] = "Bajo"), [Total Encuestados], 0)
		formatString: 0.0%
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000008

	measure 'CSAT Cobertura' = AVERAGE(Fact_Respuestas[sat_cobertura])
		formatString: 0.00
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000009

	measure 'CSAT Velocidad' = AVERAGE(Fact_Respuestas[sat_velocidad])
		formatString: 0.00
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000010

	measure 'CSAT Atención' = AVERAGE(Fact_Respuestas[sat_atencion])
		formatString: 0.00
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000011

	measure 'CSAT Precio' = AVERAGE(Fact_Respuestas[sat_precio])
		formatString: 0.00
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000012

	measure 'CSAT Datos' = AVERAGE(Fact_Respuestas[sat_datos])
		formatString: 0.00
		lineageTag: a7b1c2d3-1111-4444-8888-abcdef000013

